<Window x:Class="EasyClaude.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Easy Claude" Icon="Assets/EasyClaude.ico" Width="1280" Height="820" MinWidth="1020" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#192238" Padding="18,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ImportButton" Content="导入节点配置" Margin="8,0,0,0" Click="Import_Click"
                                ToolTip="验证配置并保存到程序目录，再重新加载连接服务" />
                        <Button x:Name="ApiKeyButton" Content="Claude API Key" Margin="8,0,14,0" Click="ApiKey_Click" />
                        <Button x:Name="RestartProxyButton" Content="重启代理" Margin="8,0,0,0" Click="RestartProxy_Click"
                                ToolTip="只重新启动代理服务，OpenCode 和会话历史保留" />
                        <Button x:Name="RestartAllButton" Content="重启程序" Margin="8,0,0,0" Click="RestartAll_Click"
                                ToolTip="重新启动 Easy Claude 和连接服务，当前生成会中断，会话历史保留" />
                        <Button x:Name="MoreButton" Content="更多 ···" Margin="8,0,0,0" Click="More_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="RecheckButton" Header="重新检测连接" Click="Recheck_Click" />
                                    <MenuItem Header="高级设置" Click="Advanced_Click" />
                                    <Separator />
                                    <MenuItem Header="打开日志目录" Click="Logs_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/EasyClaude.ico" Width="30" Height="30" Margin="0,0,10,0" />
                        <TextBlock Text="Easy Claude" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <Border x:Name="StatusBadge" DockPanel.Dock="Left" CornerRadius="5" Background="#475569" Padding="7,3" Margin="0,0,10,0">
                        <TextBlock x:Name="StatusGlyph" Text="准备中" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StatusText" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="正在启动…" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <Border x:Name="ConsistencyBadge" DockPanel.Dock="Right" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ConsistencyText" FontSize="11" />
                    </Border>
                    <TextBlock x:Name="KeyText" DockPanel.Dock="Right" Margin="12,0,0,0" MaxWidth="370" TextTrimming="CharacterEllipsis" Foreground="#AAB8CE" Text="API Key：读取中…" />
                    <TextBlock x:Name="NodeText" Foreground="#AAB8CE" Margin="0,0,18,0" MaxWidth="400" TextTrimming="CharacterEllipsis" ToolTip="启动时检测，之后每 60 秒更新延迟" />
                    <TextBlock x:Name="EgressText" Foreground="#AAB8CE" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>
        <Border x:Name="ConflictBanner" DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ConflictRecheckButton" Content="重新检测" Margin="10,0,0,0" Click="ConflictRecheck_Click" />
                    <Button x:Name="ConflictContinueButton" Content="继续连接" Margin="8,0,0,0" Click="ConflictContinue_Click" />
                </StackPanel>
                <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Foreground="#92400E" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid>
            <StackPanel x:Name="PreparationPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="580">
                <TextBlock x:Name="Overlay" FontSize="17" Foreground="#526078" TextWrapping="Wrap" TextAlignment="Center" Text="正在准备连接服务…" />
                <ProgressBar x:Name="PreparationProgress" Height="4" Margin="40,18,40,0" IsIndeterminate="True" Foreground="#6366F1" />
                <Button x:Name="RetryButton" Content="重试准备" Click="Recheck_Click" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
            </StackPanel>
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
