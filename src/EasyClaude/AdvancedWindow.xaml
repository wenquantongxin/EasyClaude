<Window x:Class="EasyClaude.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级设置" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F8FAFC">
    <StackPanel Margin="24">
        <TextBlock Text="按需加固" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
        <TextBlock Text="默认采用轻量模式。以下选项由你选择启用。" Foreground="#526078" Margin="0,8,0,20" />
        <CheckBox x:Name="StrictBox" Content="严格启动检查" FontWeight="SemiBold" />
        <TextBlock Text="启动前确认节点、出口地域和 Anthropic 连通性；发现 TUN 接管时暂停启动。可能延长启动等待。" TextWrapping="Wrap" Foreground="#526078" Margin="22,5,0,20" />
        <CheckBox x:Name="FirewallBox" Content="Windows 防火墙出网限制" FontWeight="SemiBold" />
        <TextBlock Text="仅限制本程序的 OpenCode 通过本机代理连接。首次启用和移除需要 Windows 管理员许可。" TextWrapping="Wrap" Foreground="#526078" Margin="22,5,0,8" />
        <TextBlock x:Name="FirewallText" Foreground="#526078" TextWrapping="Wrap" Margin="22,0,0,16" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="VerifyButton" Content="校验组件完整性" Click="Verify_Click" />
            <Button x:Name="RepairButton" Content="修复防火墙规则" Click="Repair_Click" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="#526078" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="保存设置" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CloseButton" Content="关闭" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
