<Window x:Class="EasyClaude.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude API Key" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F8FAFC">
    <StackPanel Margin="24">
        <TextBlock Text="Claude API Key" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
        <TextBlock x:Name="CurrentText" Margin="0,12,0,0" FontWeight="SemiBold" Text="已保存的 Key：读取中…" />
        <TextBlock Margin="0,18,0,7" Text="填写新 Key 以更换；留空则测试已保存的 Key。" Foreground="#526078" />
        <PasswordBox x:Name="KeyBox" Padding="10,8" PasswordChanged="KeyChanged" />
        <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"
                   Text="新 Key 通过 Anthropic 验证后才保存。测试会发送简短真实请求；Haiku 不可用时自动改用默认模型，可能产生少量 API 费用。" />
        <TextBlock x:Name="ResultText" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="21" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ActionButton" Content="测试已保存的 Key" IsDefault="True" Click="Action_Click" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CloseButton" Content="关闭" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
